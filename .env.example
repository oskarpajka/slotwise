# Copy to .env for local development. Never commit .env.

# Postgres (Docker Compose creates the database from these)
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=slotwise
POSTGRES_DB=slotwise
# Host port for development only, see compose.dev.yaml. The default
# compose.yaml publishes no Postgres port.
POSTGRES_PORT=5432

# Used by pnpm, drizzle-kit and the integration tests on your machine.
# Inside Docker Compose the app and migrate services build their own URL
# from the POSTGRES_* values above and reach the host "postgres".
DATABASE_URL=postgresql://slotwise:slotwise@localhost:5432/slotwise

# Better Auth
# Signs the session cookies. Use at least 32 random characters, for example
# the output of `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=
# The address you open the app at. Sign-in accepts requests only from this
# origin. `pnpm dev`: http://localhost:3000. Docker Compose on your machine:
# http://localhost:8080. Production: https://your-domain.
BETTER_AUTH_URL=http://localhost:3000

# The owner account, read only by `pnpm owner:create`. The password needs at
# least 12 characters. Delete OWNER_PASSWORD from .env once the owner exists.
OWNER_EMAIL=
OWNER_PASSWORD=

# Caddy (reverse proxy)
# ":80" serves plain HTTP locally. In production set your domain name,
# for example "salon.example.com", and Caddy gets HTTPS automatically.
SITE_ADDRESS=:80
# Host ports Caddy listens on. For a real domain set HTTP_PORT=80 and
# HTTPS_PORT=443, or certificates cannot be issued.
HTTP_PORT=8080
HTTPS_PORT=8443
