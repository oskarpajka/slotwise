# Copy to .env for local development. Never commit .env.

# Postgres (local Docker Compose)
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=slotwise
POSTGRES_DB=slotwise
POSTGRES_PORT=5432

# Used by the app, drizzle-kit and the integration tests.
DATABASE_URL=postgresql://slotwise:slotwise@localhost:5432/slotwise
