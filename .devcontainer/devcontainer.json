{
  "name": "Slotwise",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // Runs once when the Codespace is created or rebuilt: installs packages
  // and sets up the local database, printing each step (see setup.sh).
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Runs every time you open the Codespace: prints a ready/missing checklist.
  "postAttachCommand": "bash .devcontainer/status.sh",

  // Vite dev server. Start it yourself with: npm run dev
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Slotwise",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
